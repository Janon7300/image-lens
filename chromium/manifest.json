{
  "manifest_version": 3,
  "name": "Image Lens – Image Translator",
  "version": "0.3.2",
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "description": "อ่านข้อความในรูปภาพบนหน้าเว็บและแปลเป็นข้อความภาษาไทยหรืออังกฤษ ด้วยบริการ AI ของคุณ",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Lens"
  },
  "options_page": "options.html"
}
